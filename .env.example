# FilingLens configuration template. Copy to `.env` and fill in values.
# Never commit a real `.env`.

FILINGLENS_ENV=development
FILINGLENS_LOG_LEVEL=INFO
FILINGLENS_LOG_JSON=false
FILINGLENS_DB_PATH=./data/filinglens.db
FILINGLENS_RAW_DIR=./data/raw
FILINGLENS_CACHE_DIR=./cache

# SEC fair access: descriptive User-Agent with contact is required for live mode.
SEC_USER_AGENT=
SEC_MAX_RPS=5
SEC_MAX_CONCURRENCY=2
SEC_LIVE_MODE=false

# Optional LLM provider (deterministic fake is used when unset).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
